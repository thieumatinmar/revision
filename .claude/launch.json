{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-revision",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os, http.server; http.server.ThreadingHTTPServer.allow_reuse_address = True; http.server.ThreadingHTTPServer(('127.0.0.1', int(os.environ.get('PORT', '8130'))), http.server.SimpleHTTPRequestHandler).serve_forever()"
      ],
      "port": 8130,
      "autoPort": true
    }
  ]
}
